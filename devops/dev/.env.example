# Copy to devops/dev/.env on the server (./devops/dev/setup.sh does this) and fill in.
# devops/dev/.env is git-ignored; never commit the real file.

# OCR service (required). Documents are sent over plain HTTP to a third-party server.
OCR_API_BASE_URL=http://n2.ckey.vn:1436
OCR_API_KEY=

# File links + result callbacks (ADR 0006). Only on the server that https://ocr.dc1.merket.io reaches: the OCR
# service downloads uploaded files from, and posts results to, this address (https only, host must be allowed by
# the AI team). Leave empty to upload files directly as before.
OCR_APP_URL=
# Signs the results the OCR service posts back. The AI team hands it over separately (never by chat or e-mail).
OCR_CALLBACK_SECRET=

# Port the app listens on, on this server.
APP_PORT=5286

# Word editor (OnlyOffice Docs, ADR 0004). Browsers load the editor from DOCS_EDITOR_PUBLIC_URL, so use an
# address people can open: http://<this server>:<DOCS_PORT> when others use the app from their machines.
DOCS_EDITOR_PUBLIC_URL=http://localhost:8085
DOCS_PORT=8085
# Shared by the app and the document server, at least 32 characters. ./devops/dev/setup.sh generates one.
DOCS_EDITOR_JWT_SECRET=
