@inherits LayoutComponentBase
@inject IStringLocalizer<SharedText> Text

@* Layout for pages shown before sign-in: no navigation, only the brand and the language switch. *@
<div class="auth-page">
    <header class="auth-header">
        <span class="auth-brand">
            <span class="auth-brand-mark" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="5" y="3" width="14" height="18" rx="2.5" /><path d="M8.5 8h7M8.5 12h7M8.5 16h4" />
                </svg>
            </span>
            <strong>@Text["AppName"]</strong>
        </span>
        <LanguageSwitch />
    </header>
    <main class="auth-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Text["UnhandledError"]
    <a href="." class="reload">@Text["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
