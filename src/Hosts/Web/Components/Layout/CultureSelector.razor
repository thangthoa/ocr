@using System.Globalization
@using OppOcr.Web.Localization
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedText> Text

<nav class="culture-selector" aria-label="@Text["Language"]">
    @foreach (var culture in LocalizationSetup.SupportedCultures)
    {
        var current = string.Equals(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, culture, StringComparison.OrdinalIgnoreCase);
        var label = CultureInfo.GetCultureInfo(culture).NativeName;
        @* Full page load so the new culture applies to the server render and the Blazor circuit. *@
        <a href="@SetCultureUrl(culture)" data-enhance-nav="false" lang="@culture"
           class="@(current ? "fw-bold" : null)" aria-current="@(current ? "true" : null)">@label</a>
    }
</nav>

@code {
    private string SetCultureUrl(string culture)
    {
        var returnPath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        return $"culture/set?culture={Uri.EscapeDataString(culture)}&redirectUri={Uri.EscapeDataString(returnPath)}";
    }
}
