@using System.Globalization
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedText> Text

@* One button to the other language (the app has two). A full page load so the new culture applies
   to the server render and to the Blazor circuit. *@
<a class="language-switch" href="@SetCultureUrl(Target)" data-enhance-nav="false" lang="@Target" hreflang="@Target"
   title="@Text["SwitchLanguage", Label]">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" />
    </svg>
    <span>@Label</span>
</a>

@code {
    private static string Target => LocalizationSetup.SupportedCultures.First(culture =>
        !string.Equals(culture, CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, StringComparison.OrdinalIgnoreCase));

    private static string Label => CultureInfo.GetCultureInfo(Target).NativeName;

    private string SetCultureUrl(string culture)
    {
        var returnPath = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        return $"culture/set?culture={Uri.EscapeDataString(culture)}&redirectUri={Uri.EscapeDataString(returnPath)}";
    }
}
