@inherits LayoutComponentBase
@inject IStringLocalizer<SharedText> Text

<div class="page">
    <header class="app-header">
        <a class="app-brand" href="">
            <span class="app-brand-name">@Text["AppName"]</span>
            <span class="app-brand-product">@Text["AppProduct"]</span>
        </a>
        <div class="app-header-actions">
            @* A native disclosure works in this static layout without a circuit; wwwroot/js/account-menu.js
               only adds closing on an outside click or Escape.
               Mockup only: there is no authentication yet, so the user is always the demo account. *@
            <details class="account-menu">
                <summary class="account-toggle" title="@Text["AccountMenu", DemoUser]">
                    <span class="avatar" aria-hidden="true">@Initial</span>
                    <span class="visually-hidden">@Text["AccountMenu", DemoUser]</span>
                </summary>
                <div class="account-panel">
                    <div class="account-who">
                        <span class="avatar avatar-lg" aria-hidden="true">@Initial</span>
                        <div class="min-w-0">
                            <div class="account-name" dir="ltr">@DemoUser</div>
                            <div class="account-role">@Text["DemoRole"]</div>
                        </div>
                    </div>
                    <div class="account-section">
                        <div class="account-heading" id="account-language">@Text["Language"]</div>
                        <CultureSelector />
                    </div>
                    <a class="account-item account-signout" href="login">@Text["SignOut"]</a>
                </div>
            </details>
        </div>
    </header>

    <div class="app-body">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
</div>

@* Interactive island in the static layout: job notifications appear on every page. *@
<OppOcr.Web.Features.Ocr.Components.OcrToasts @rendermode="InteractiveServer" />

<div id="blazor-error-ui" data-nosnippet>
    @Text["UnhandledError"]
    <a href="." class="reload">@Text["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string DemoUser = "admin";

    private static string Initial => DemoUser[..1].ToUpperInvariant();
}
