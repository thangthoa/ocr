@inject IStringLocalizer<SharedText> Text
@inject NavigationManager Navigation

<div class="nav-mobile-bar">
    <span class="nav-mobile-label" aria-hidden="true">@Text["NavMenu"]</span>
</div>

<input type="checkbox" title="@Text["NavToggle"]" aria-label="@Text["NavToggle"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    @* The flow of a document comes first (Scan → Review Queue → archive), then Reports; Users and Settings are set
       apart at the end. *@
    <nav class="nav flex-column" aria-label="@Text["NavMain"]">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-dashboard-nav-menu" aria-hidden="true"></span> @Text["NavDashboard"]
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="scan">
                <span class="bi bi-scan-nav-menu" aria-hidden="true"></span> @Text["NavCapture"]
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="review">
                <span class="bi bi-review-nav-menu" aria-hidden="true"></span> @Text["NavReview"]
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="documents">
                <span class="bi bi-documents-nav-menu" aria-hidden="true"></span> @Text["NavDocuments"]
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="archive">
                <span class="bi bi-archive-nav-menu" aria-hidden="true"></span> @Text["NavApproved"]
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="reports">
                <span class="bi bi-reports-nav-menu" aria-hidden="true"></span> @Text["NavReports"]
            </NavLink>
        </div>
        <div class="nav-separator" aria-hidden="true"></div>
        @* Administration: the Users group opens by itself on its own pages. A native disclosure, so it works in this
           static layout; stopping the click keeps the phone menu from closing when the group is toggled. *@
        <details class="nav-group" open="@InUsers">
            <summary class="nav-group-toggle @(InUsers ? "is-current" : null)" onclick="event.stopPropagation()">
                <span class="bi bi-users-nav-menu" aria-hidden="true"></span>
                <span class="nav-group-label">@Text["NavUsersGroup"]</span>
                <span class="nav-group-chevron" aria-hidden="true"></span>
            </summary>
            <div class="nav-item nav-subitem">
                <NavLink class="nav-link" href="users" Match="NavLinkMatch.All">@Text["NavUsers"]</NavLink>
            </div>
            <div class="nav-item nav-subitem">
                <NavLink class="nav-link" href="users/roles">@Text["NavRoles"]</NavLink>
            </div>
            <div class="nav-item nav-subitem">
                <NavLink class="nav-link" href="users/activity">@Text["NavActivity"]</NavLink>
            </div>
        </details>
        <div class="nav-item">
            <NavLink class="nav-link" href="admin">
                <span class="bi bi-settings-nav-menu" aria-hidden="true"></span> @Text["NavAdmin"]
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool InUsers
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            return path == "users" || path.StartsWith("users/", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("users?", StringComparison.OrdinalIgnoreCase);
        }
    }
}
