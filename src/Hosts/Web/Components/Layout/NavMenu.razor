@inject IStringLocalizer<SharedText> Text

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">@Text["AppName"]</a>
    </div>
</div>

<input type="checkbox" title="@Text["NavToggle"]" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> @Text["NavHome"]
            </NavLink>
        </div>

        @* Native disclosure: works in the static layout without JavaScript. Clicks on the
           summary must not bubble to .nav-scrollable, which closes the mobile menu. *@
        <details class="nav-group px-3" open onclick="event.stopPropagation()">
            <summary class="nav-link">
                <span class="bi bi-file-text-nav-menu" aria-hidden="true"></span> @Text["NavOcrGroup"]
            </summary>
            <div class="nav-item nav-subitem">
                <NavLink class="nav-link" href="ocr" Match="NavLinkMatch.All">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> @Text["NavOcrScan"]
                </NavLink>
            </div>
            <div class="nav-item nav-subitem">
                <NavLink class="nav-link" href="ocr/jobs">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> @Text["NavOcrJobs"]
                </NavLink>
            </div>
        </details>
    </nav>
</div>
