@page "/"
@inject IStringLocalizer<SharedText> Text

<PageTitle>@Text["AppName"]</PageTitle>

<h1 class="h3 mb-4">@Text["AppName"]</h1>

<div class="row row-cols-1 row-cols-md-3 g-3">
    <div class="col">
        <a href="ocr" class="card h-100 text-decoration-none">
            <div class="card-body">
                <h2 class="h5 card-title">@Text["FeatureOcrTitle"]</h2>
                <p class="card-text text-muted">@Text["FeatureOcrDescription"]</p>
            </div>
        </a>
    </div>
</div>
