@* Two-step destructive action: the first click asks, the second one acts. *@
@if (_confirming)
{
    <span class="d-inline-flex gap-1" role="group" aria-label="@ConfirmGroupLabel">
        <button type="button" class="btn btn-sm btn-danger" disabled="@Busy" @onclick="ConfirmAsync">@(Busy ? BusyLabel : ConfirmLabel)</button>
        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@Busy" @onclick="() => _confirming = false">@CancelLabel</button>
    </span>
}
else
{
    <button type="button" class="btn btn-sm btn-outline-danger" aria-label="@AriaLabel" @onclick="() => _confirming = true">@Label</button>
}

@code {
    private bool _confirming;

    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter, EditorRequired] public string ConfirmLabel { get; set; } = default!;
    [Parameter, EditorRequired] public string CancelLabel { get; set; } = default!;
    [Parameter, EditorRequired] public string BusyLabel { get; set; } = default!;
    [Parameter, EditorRequired] public string ConfirmGroupLabel { get; set; } = default!;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter, EditorRequired] public EventCallback OnConfirm { get; set; }

    private async Task ConfirmAsync()
    {
        await OnConfirm.InvokeAsync();
        _confirming = false;
    }
}
