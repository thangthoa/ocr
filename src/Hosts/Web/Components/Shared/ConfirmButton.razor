@* Destructive action: the button opens a warning dialog, and only its confirm button acts. *@
<button type="button" class="btn btn-sm btn-outline-danger" aria-label="@AriaLabel" aria-haspopup="dialog"
        @ref="_trigger" @onclick="Open">@Label</button>

@if (_open)
{
    <div class="confirm-overlay" @onclick="CloseAsync"></div>
    <div class="confirm-dialog" role="alertdialog" aria-modal="true" aria-labelledby="@($"{_id}-title")"
         aria-describedby="@($"{_id}-message")" @onkeydown="OnKeyDownAsync">
        <div class="confirm-body">
            <h2 id="@($"{_id}-title")" class="confirm-title" dir="auto">@Title</h2>
            <p id="@($"{_id}-message")" class="confirm-message">@Message</p>
        </div>
        <div class="confirm-actions">
            <button type="button" class="btn btn-secondary" disabled="@Busy" @ref="_cancel" @onclick="CloseAsync">@CancelLabel</button>
            <button type="button" class="btn btn-danger" disabled="@Busy" @onclick="ConfirmAsync">@(Busy ? BusyLabel : ConfirmLabel)</button>
        </div>
    </div>
}

@code {
    private readonly string _id = "confirm-" + Guid.NewGuid().ToString("N")[..8];
    private ElementReference _trigger;
    private ElementReference _cancel;
    private bool _open;
    private bool _focusCancel;

    [Parameter, EditorRequired] public string Label { get; set; } = default!;
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter, EditorRequired] public string Message { get; set; } = default!;
    [Parameter, EditorRequired] public string ConfirmLabel { get; set; } = default!;
    [Parameter, EditorRequired] public string CancelLabel { get; set; } = default!;
    [Parameter, EditorRequired] public string BusyLabel { get; set; } = default!;
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter, EditorRequired] public EventCallback OnConfirm { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The safe choice gets focus, so Enter right after opening does not delete anything.
        if (_focusCancel)
        {
            _focusCancel = false;
            await _cancel.FocusAsync();
        }
    }

    private void Open()
    {
        _open = true;
        _focusCancel = true;
    }

    private async Task CloseAsync()
    {
        if (Busy)
            return;
        _open = false;
        await _trigger.FocusAsync();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await CloseAsync();
    }

    private async Task ConfirmAsync()
    {
        await OnConfirm.InvokeAsync();
        _open = false;
    }
}
