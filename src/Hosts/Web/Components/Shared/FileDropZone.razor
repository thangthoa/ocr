<div class="upload-zone @(_dragOver ? "drag-over" : null) @(Disabled ? "disabled" : null)"
     @ondragenter="() => _dragOver = true"
     @ondragleave="() => _dragOver = false"
     @ondrop="() => _dragOver = false">
    <InputFile id="@Id" OnChange="HandleChangeAsync" multiple="@Multiple" accept="@Accept" disabled="@Disabled"
               aria-label="@Prompt" aria-describedby="@($"{Id}-hint")" />
    <div class="upload-zone-text" aria-hidden="true">
        <div class="fs-5">@Prompt</div>
    </div>
    <div id="@($"{Id}-hint")" class="text-muted small">@Hint</div>
</div>

@code {
    private bool _dragOver;

    [Parameter, EditorRequired]
    public string Id { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Accept { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Prompt { get; set; } = default!;

    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Multiple { get; set; } = true;

    [Parameter, EditorRequired]
    public EventCallback<InputFileChangeEventArgs> OnFilesSelected { get; set; }

    private Task HandleChangeAsync(InputFileChangeEventArgs e)
    {
        _dragOver = false;
        return OnFilesSelected.InvokeAsync(e);
    }
}
