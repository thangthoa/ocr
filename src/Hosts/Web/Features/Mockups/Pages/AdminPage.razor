@page "/admin"
@rendermode InteractiveServer
@using Microsoft.Extensions.Diagnostics.HealthChecks

<PageTitle>@Text["Admin.Title"]</PageTitle>

<h1 class="h3 mb-3">@Text["Admin.Title"]</h1>

<div role="tablist" class="admin-tabs mb-3" aria-label="@Text["Admin.Sections"]">
    @foreach (var tab in Enum.GetValues<AdminTab>())
    {
        var selected = tab == _tab;
        <button type="button" role="tab" id="@($"tab-{tab}")" aria-controls="@($"panel-{tab}")"
                aria-selected="@(selected ? "true" : "false")" class="@(selected ? "active" : null)"
                @onclick="() => SelectAsync(tab)">@Text[$"Admin.Tab.{tab}"]</button>
    }
</div>

<div id="@($"panel-{_tab}")" role="tabpanel" aria-labelledby="@($"tab-{_tab}")">
    @switch (_tab)
    {
        case AdminTab.Retention:
            <p class="small text-muted"><span class="badge tag-gray me-1">@Text["SampleData"]</span> @Text["Retention.Note"]</p>
            <div class="table-responsive position-relative">
                <table class="table align-middle">
                    <caption class="visually-hidden">@Text["Admin.Tab.Retention"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@Text["Column.Department"]</th>
                            <th scope="col">@Text["Column.Kind"]</th>
                            <th scope="col">@Text["Retention.Column.Keep"]</th>
                            <th scope="col">@Text["Retention.Column.From"]</th>
                            <th scope="col">@Text["Retention.Column.Then"]</th>
                            <th scope="col" class="text-end">@Text["Retention.Column.Documents"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in Retention)
                        {
                            <tr>
                                <td>@Text.Department(rule.Department)</td>
                                <td>@Text.Kind(rule.Kind)</td>
                                <td>@(rule.Years is { } years ? Text["Retention.Years", years] : Text["Retention.Permanent"])</td>
                                <td>@Text[$"Retention.From.{rule.From}"]</td>
                                <td>@Text[$"Retention.Then.{rule.Then}"]</td>
                                <td class="text-end"><a href="@($"documents?department={rule.Department}&kind={rule.Kind}")">@DocumentsUnder(rule)</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            break;

        case AdminTab.Quality:
            <p class="small text-muted"><span class="badge tag-gray me-1">@Text["Confidence.Simulated"]</span> @Text["QualitySettings.Note"]</p>
            <form id="quality-form" class="quality-form" novalidate @onsubmit="SaveQuality">
                <fieldset class="mb-4">
                    <legend class="h6">@Text["QualitySettings.Thresholds"]</legend>
                    <div class="row g-3">
                        <div class="col-sm-6 col-lg-4">
                            <label for="min-document" class="form-label">@Text["QualitySettings.MinDocument"]</label>
                            <div class="input-group has-validation">
                                <input id="min-document" type="number" min="0" max="100" step="0.1" dir="ltr"
                                       class="form-control @(_qualityErrors.ContainsKey(MinDocumentField) ? "is-invalid" : null)"
                                       @bind="_quality.MinDocument" aria-describedby="min-document-hint @(_qualityErrors.ContainsKey(MinDocumentField) ? "min-document-error" : null)" />
                                <span class="input-group-text">%</span>
                                @if (_qualityErrors.TryGetValue(MinDocumentField, out var documentError))
                                {
                                    <div id="min-document-error" class="invalid-feedback">@documentError</div>
                                }
                            </div>
                            <div id="min-document-hint" class="form-text">@Text["QualitySettings.MinDocumentHint"]</div>
                        </div>
                        <div class="col-sm-6 col-lg-4">
                            <label for="min-page" class="form-label">@Text["QualitySettings.MinPage"]</label>
                            <div class="input-group has-validation">
                                <input id="min-page" type="number" min="0" max="100" step="0.1" dir="ltr"
                                       class="form-control @(_qualityErrors.ContainsKey(MinPageField) ? "is-invalid" : null)"
                                       @bind="_quality.MinPage" aria-describedby="min-page-hint @(_qualityErrors.ContainsKey(MinPageField) ? "min-page-error" : null)" />
                                <span class="input-group-text">%</span>
                                @if (_qualityErrors.TryGetValue(MinPageField, out var pageError))
                                {
                                    <div id="min-page-error" class="invalid-feedback">@pageError</div>
                                }
                            </div>
                            <div id="min-page-hint" class="form-text">@Text["QualitySettings.MinPageHint"]</div>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="mb-4">
                    <legend class="h6">@Text["QualitySettings.Rules"]</legend>
                    <div class="form-check">
                        <input id="flag-warnings" type="checkbox" class="form-check-input" @bind="_quality.FlagWarnings" />
                        <label for="flag-warnings" class="form-check-label">@Text["QualitySettings.FlagWarnings"]</label>
                    </div>
                    <div class="form-check">
                        <input id="flag-empty" type="checkbox" class="form-check-input" @bind="_quality.FlagEmptyPages" />
                        <label for="flag-empty" class="form-check-label">@Text["QualitySettings.FlagEmpty"]</label>
                    </div>
                </fieldset>

                <fieldset class="mb-4" aria-describedby="required-hint">
                    <legend class="h6">@Text["QualitySettings.Required"]</legend>
                    <p id="required-hint" class="small text-muted mb-2">@Text["QualitySettings.RequiredHint"]</p>
                    @foreach (var field in Enum.GetValues<RequiredMetadata>())
                    {
                        var id = $"require-{field}";
                        <div class="form-check form-check-inline">
                            <input id="@id" type="checkbox" class="form-check-input" checked="@_quality.Required.Contains(field)"
                                   @onchange="e => SetRequired(field, e.Value is true)" />
                            <label for="@id" class="form-check-label">@Text.Required(field)</label>
                        </div>
                    }
                </fieldset>

                <fieldset class="mb-4">
                    <legend class="h6">@Text["QualitySettings.Passed"]</legend>
                    <div class="form-check">
                        <input id="passed-approve" type="radio" name="passed" class="form-check-input" checked="@_quality.AutoApprove"
                               @onchange="() => _quality.AutoApprove = true" />
                        <label for="passed-approve" class="form-check-label">@Text["QualitySettings.AutoApprove"]</label>
                    </div>
                    <div class="form-check">
                        <input id="passed-review" type="radio" name="passed" class="form-check-input" checked="@(!_quality.AutoApprove)"
                               @onchange="() => _quality.AutoApprove = false" />
                        <label for="passed-review" class="form-check-label">@Text["QualitySettings.SendToReview"]</label>
                    </div>
                </fieldset>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="submit" id="quality-save" class="btn btn-primary">@Text["QualitySettings.Save"]</button>
                    <button type="button" id="quality-defaults" class="btn btn-outline-secondary" @onclick="QualityDefaults">@Text["QualitySettings.Defaults"]</button>
                    @if (_qualitySaved)
                    {
                        <span id="quality-saved" class="small" role="status">@Text["QualitySettings.Saved"]</span>
                    }
                    else if (_qualityErrors.Count > 0)
                    {
                        <span class="small text-danger" role="alert">@Text["Edit.FixErrors"]</span>
                    }
                </div>
            </form>
            break;

        case AdminTab.Kpi:
            <p class="small text-muted"><span class="badge tag-gray me-1">@Text["SampleData"]</span> @Text["KpiSettings.Note"]</p>
            <form id="kpi-form" novalidate @onsubmit="SaveKpis">
                <fieldset class="mb-4">
                    <legend class="h6">@Text["KpiSettings.Project"]</legend>
                    <div class="row g-3">
                        <div class="col-sm-6 col-lg-4">
                            <label for="@ProjectPagesField" class="form-label">@Text["KpiSettings.ProjectPages"]</label>
                            <input id="@ProjectPagesField" type="number" min="1" step="1000" dir="ltr"
                                   class="form-control @(_kpiErrors.ContainsKey(ProjectPagesField) ? "is-invalid" : null)"
                                   @bind="_kpi.TotalPages" aria-describedby="@ErrorId(ProjectPagesField)" />
                            <FieldError Id="@ProjectPagesField" Errors="_kpiErrors" />
                        </div>
                        <div class="col-6 col-lg-3">
                            <label for="@ProjectStartField" class="form-label">@Text["KpiSettings.ProjectStart"]</label>
                            <input id="@ProjectStartField" type="date"
                                   class="form-control @(_kpiErrors.ContainsKey(ProjectStartField) ? "is-invalid" : null)"
                                   @bind="_kpi.Start" aria-describedby="@ErrorId(ProjectStartField)" />
                            <FieldError Id="@ProjectStartField" Errors="_kpiErrors" />
                        </div>
                        <div class="col-6 col-lg-3">
                            <label for="@ProjectEndField" class="form-label">@Text["KpiSettings.ProjectEnd"]</label>
                            <input id="@ProjectEndField" type="date"
                                   class="form-control @(_kpiErrors.ContainsKey(ProjectEndField) ? "is-invalid" : null)"
                                   @bind="_kpi.End" aria-describedby="@ErrorId(ProjectEndField)" />
                            <FieldError Id="@ProjectEndField" Errors="_kpiErrors" />
                        </div>
                    </div>
                </fieldset>

                <fieldset class="mb-4" aria-describedby="kpi-targets-hint">
                    <legend class="h6">@Text["KpiSettings.Targets"]</legend>
                    <p id="kpi-targets-hint" class="small text-muted mb-2">@Text["KpiSettings.TargetsHint"]</p>
                    <div class="table-responsive position-relative">
                        <table class="table align-middle kpi-table">
                            <caption class="visually-hidden">@Text["KpiSettings.Targets"]</caption>
                            <thead>
                                <tr>
                                    <th scope="col">@Text["KpiSettings.Column.Kpi"]</th>
                                    <th scope="col">@Text["KpiSettings.Column.Goal"]</th>
                                    <th scope="col">@Text["KpiSettings.Column.Target"]</th>
                                    <th scope="col">@Text["KpiSettings.Column.Alert"]</th>
                                    <th scope="col">@Text["KpiSettings.Column.Show"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _kpi.Rows)
                                {
                                    var kind = row.Kind;
                                    var name = Text.KpiName(kind);
                                    var unit = Text[$"KpiUnit.{KpiRules.Unit(kind)}"];
                                    var step = KpiRules.Unit(kind) switch { KpiUnit.Percent => "0.1", KpiUnit.Hours => "0.5", _ => "1" };
                                    var targetField = TargetField(kind);
                                    var alertField = AlertField(kind);
                                    <tr>
                                        <th scope="row" class="fw-normal">
                                            <span class="fw-semibold">@name</span>
                                            <span class="d-block small text-muted">@Text[$"KpiDef.{kind}.Hint"]</span>
                                        </th>
                                        <td class="text-nowrap">@Text[$"KpiSettings.Direction.{KpiRules.Direction(kind)}"]</td>
                                        <td>
                                            <div class="input-group input-group-sm has-validation kpi-input">
                                                <input id="@targetField" type="number" min="0" step="@step" dir="ltr"
                                                       class="form-control @(_kpiErrors.ContainsKey(targetField) ? "is-invalid" : null)"
                                                       @bind="row.Target" aria-label="@Text["KpiSettings.TargetFor", name]"
                                                       aria-describedby="@ErrorId(targetField)" />
                                                <span class="input-group-text">@unit</span>
                                                <FieldError Id="@targetField" Errors="_kpiErrors" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm has-validation kpi-input">
                                                <input id="@alertField" type="number" min="0" step="@step" dir="ltr"
                                                       class="form-control @(_kpiErrors.ContainsKey(alertField) ? "is-invalid" : null)"
                                                       @bind="row.Alert" aria-label="@Text["KpiSettings.AlertFor", name]"
                                                       aria-describedby="@ErrorId(alertField)" />
                                                <span class="input-group-text">@unit</span>
                                                <FieldError Id="@alertField" Errors="_kpiErrors" />
                                            </div>
                                        </td>
                                        <td>
                                            <input id="@($"kpi-{kind}-show")" type="checkbox" class="form-check-input" @bind="row.Show"
                                                   aria-label="@Text["KpiSettings.ShowFor", name]" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </fieldset>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="submit" id="kpi-save" class="btn btn-primary">@Text["KpiSettings.Save"]</button>
                    <button type="button" id="kpi-defaults" class="btn btn-outline-secondary" @onclick="KpiDefaults">@Text["QualitySettings.Defaults"]</button>
                    @if (_kpiSaved)
                    {
                        <span id="kpi-saved" class="small" role="status">@Text["KpiSettings.Saved"] <a href="dashboard">@Text["KpiSettings.OpenDashboard"]</a></span>
                    }
                    else if (_kpiErrors.Count > 0)
                    {
                        <span class="small text-danger" role="alert">@Text["Edit.FixErrors"]</span>
                    }
                </div>
            </form>
            break;

        case AdminTab.Integrations:
            <p class="small text-muted">@Text["Integrations.Note"]</p>
            <div class="table-responsive position-relative">
                <table class="table align-middle">
                    <caption class="visually-hidden">@Text["Admin.Tab.Integrations"]</caption>
                    <thead>
                        <tr>
                            <th scope="col">@Text["Integrations.Column.System"]</th>
                            <th scope="col">@Text["Integrations.Column.Purpose"]</th>
                            <th scope="col">@Text["Integrations.Column.Status"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-semibold">@Text["Integration.Ocr"]</td>
                            <td>@Text["Integration.Ocr.Purpose"]</td>
                            <td>
                                <span class="d-inline-flex flex-wrap align-items-center gap-2">
                                    @if (_checking || _ocrHealth is null)
                                    {
                                        <span id="ocr-health" class="badge tag-gray">@Text["Integration.Status.Checking"]</span>
                                    }
                                    else if (_ocrHealth == HealthStatus.Healthy)
                                    {
                                        <span id="ocr-health" class="badge tag-green">@Text["Integration.Status.Connected"]</span>
                                    }
                                    else
                                    {
                                        <span id="ocr-health" class="badge tag-red">@Text["Integration.Status.Down"]</span>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_checking" @onclick="CheckAsync">@Text["Integrations.Check"]</button>
                                </span>
                            </td>
                        </tr>
                        @foreach (var system in PlannedSystems)
                        {
                            <tr>
                                <td class="fw-semibold">@Text[$"Integration.{system}"]</td>
                                <td>@Text[$"Integration.{system}.Purpose"]</td>
                                <td><span class="badge tag-purple">@Text["Integration.Status.Planned"]</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            break;
    }
</div>
