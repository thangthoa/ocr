@page "/"
@page "/dashboard"
@rendermode InteractiveServer

<PageTitle>@Text["Dashboard.Title"]</PageTitle>

<div class="d-flex flex-wrap align-items-end gap-3 mb-4">
    <div class="me-auto">
        <h1 class="h3 mb-1">@Text["Dashboard.Title"]</h1>
        <p class="text-muted mb-0">
            <span id="report-range">@RangeLabel</span>
            <span class="badge tag-gray ms-2">@Text["SampleData"]</span>
        </p>
    </div>
    <div class="content-switcher" role="group" aria-label="@Text["Period.Label"]">
        @foreach (var period in Enum.GetValues<ReportPeriod>())
        {
            var selected = period == _period;
            <button type="button" id="@($"period-{period}")" class="@(selected ? "active" : null)"
                    aria-pressed="@(selected ? "true" : "false")" @onclick="() => _period = period">@Text.Period(period)</button>
        }
    </div>
</div>

<section class="dash-card status-card mb-4" aria-labelledby="status-title">
    <div class="dash-card-head">
        <h2 id="status-title" class="h5 mb-0">@Text["Status.Heading"]</h2>
        <span class="text-muted small">
            @Text["Status.Total", FormatNumber(Report.Documents)] ·
            @Text["Kpi.VsPrevious", FormatSigned(Report.DocumentsChangePercent, "0.0") + "%"]
        </span>
        <a class="dash-card-link" href="documents">@Text["Dashboard.OpenDocuments"]</a>
    </div>
    <StatusBreakdown Counts="StatusCounts" Label="@Text["Status.Heading"]" Href="StatusUrl" />
</section>

<section class="kpi-grid mb-4" aria-label="@Text["Kpi.Heading"]">
    <div class="kpi kpi-primary">
        <span class="kpi-label">@Text["Kpi.Pages"]</span>
        <span class="kpi-value" id="kpi-pages">@FormatNumber(Report.Pages)</span>
        <span class="kpi-meter" aria-hidden="true"><span style="width: @CssPercent(PagesPercent)"></span></span>
        <span class="kpi-note">@Text["Kpi.PagesTarget", FormatPercent(PagesPercent), FormatNumber(Report.PagesTarget)]</span>
        <span class="kpi-note">@Text["Kpi.VsPrevious", FormatSigned(Report.PagesChangePercent, "0.0") + "%"]</span>
    </div>
    <div class="kpi">
        <span class="kpi-label">@Text["Kpi.Confidence"]</span>
        <span class="kpi-value">@FormatPercent(Report.Confidence)</span>
        <span class="kpi-note">@Text["Kpi.PointsChange", FormatSigned(Report.ConfidenceChangePoints, "0.0")]</span>
    </div>
    <div class="kpi kpi-attention">
        <span class="kpi-label">@Text["Kpi.Review"]</span>
        <span class="kpi-value">@FormatNumber(Report.WaitingReview)</span>
        <span class="kpi-note">@Text["Kpi.ReviewNow"]</span>
        <div class="kpi-actions">
            <a class="btn btn-sm btn-primary" href="review">@Text["Kpi.OpenReview"]</a>
            <a class="kpi-failed" href="documents?status=Failed">@Text["Kpi.Failed", FormatNumber(Report.Failed)]</a>
        </div>
    </div>
</section>

<div class="dash-row mb-4">
    <section class="dash-card dash-chart" aria-labelledby="chart-title">
        <h2 id="chart-title" class="h5">@ChartTitle</h2>
        <div class="bar-chart" role="img" aria-label="@ChartSummary">
            <div class="bar-axis" aria-hidden="true">
                <span>@FormatNumber(ScaleMax)</span>
                <span>@FormatNumber(ScaleMax / 2)</span>
                <span>0</span>
            </div>
            <div class="bar-area">
                <div class="bar-plot">
                    <span class="bar-gridline" style="bottom: 50%" aria-hidden="true"></span>
                    <span class="bar-gridline" style="bottom: 100%" aria-hidden="true"></span>
                    <div class="bars">
                        @for (var i = 0; i < Report.Bars.Count; i++)
                        {
                            var bar = Report.Bars[i];
                            @* The last bar is the hour or day still in progress, so it is drawn apart. *@
                            <div class="bar-slot" title="@Text["Chart.BarTip", BarLabel(bar, full: true), FormatNumber(bar.Pages)]">
                                <span class="bar @(i == Report.Bars.Count - 1 ? "bar-current" : null)" style="height: @CssPercent(bar.Pages * 100d / ScaleMax)"></span>
                            </div>
                        }
                    </div>
                    <span class="bar-target" style="bottom: @CssPercent(Report.BarTarget * 100d / ScaleMax)" aria-hidden="true">
                        <span>@Text["Chart.Target", FormatNumber(Report.BarTarget)]</span>
                    </span>
                </div>
                <div class="bar-labels" aria-hidden="true">
                    @for (var i = 0; i < Report.Bars.Count; i++)
                    {
                        <span>@(ShowLabel(i) ? BarLabel(Report.Bars[i], full: false) : null)</span>
                    }
                </div>
            </div>
        </div>
        <div class="chart-legend" aria-hidden="true">
            <span><i class="legend-bar"></i>@Text["Chart.Pages"]</span>
            <span><i class="legend-bar legend-current"></i>@Text["Chart.Current"]</span>
            <span><i class="legend-target"></i>@Text["Chart.TargetLegend"]</span>
        </div>
        <details class="mt-3">
            <summary class="small">@Text["Chart.ShowTable"]</summary>
            <div class="table-responsive position-relative mt-2">
                <table class="table table-sm">
                    <caption class="visually-hidden">@ChartTitle</caption>
                    <thead>
                        <tr>
                            <th scope="col">@Text["Chart.Period"]</th>
                            <th scope="col" class="text-end">@Text["Chart.Pages"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bar in Report.Bars)
                        {
                            <tr>
                                <td>@BarLabel(bar, full: true)</td>
                                <td class="text-end">@FormatNumber(bar.Pages)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    </section>

    <section class="dash-card dash-dept" aria-labelledby="dept-title">
        <h2 id="dept-title" class="h5">@Text["Dept.Heading"]</h2>
        <div class="table-responsive position-relative">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">@Text["Dept.Heading"]</caption>
                <thead>
                    <tr>
                        <th scope="col">@Text["Dept.Department"]</th>
                        <th scope="col" class="text-end">@Text["Dept.Documents"]</th>
                        <th scope="col" class="text-end">@Text["Dept.Pages"]</th>
                        <th scope="col" class="text-end">@Text["Dept.Confidence"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Report.Departments)
                    {
                        <tr>
                            <td><a href="@($"documents?department={row.Department}")">@Text.Department(row.Department)</a></td>
                            <td class="text-end">@FormatNumber(row.Documents)</td>
                            <td class="text-end">@FormatNumber(row.Pages)</td>
                            <td class="text-end">@FormatPercent(row.Confidence)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
