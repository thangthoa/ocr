@page "/"
@page "/dashboard"
@rendermode InteractiveServer

<PageTitle>@Text["Dashboard.Title"]</PageTitle>

@if (_report is null)
{
    <h1 class="h3 mb-3">@Text["Dashboard.Title"]</h1>
    @if (_loadError is not null)
    {
        <div class="alert alert-danger d-flex flex-wrap align-items-center gap-2 py-2" role="alert">
            <span class="me-auto">@_loadError</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync">@OcrText["Retry"]</button>
        </div>
    }
    else
    {
        <p class="text-muted" role="status">@OcrText["Loading"]</p>
    }
    return;
}

<div class="d-flex flex-wrap align-items-end gap-3 mb-4">
    <div class="me-auto">
        <h1 class="h3 mb-1">@Text["Dashboard.Title"]</h1>
        <p class="text-muted mb-0">
            <span id="report-range">@RangeLabel</span>
            @if (HasSimulatedData)
            {
                <span class="badge tag-gray ms-2">@Text["SampleData"]</span>
            }
        </p>
    </div>
    <div class="content-switcher" role="group" aria-label="@Text["Period.Label"]">
        @foreach (var period in Enum.GetValues<ReportPeriod>())
        {
            var selected = period == _period;
            <button type="button" id="@($"period-{period}")" class="@(selected ? "active" : null)"
                    aria-pressed="@(selected ? "true" : "false")" @onclick="() => SelectPeriod(period)">@Text.Period(period)</button>
        }
    </div>
</div>

@if (_snapshot!.List.JobsError is { } jobsError)
{
    <div class="alert alert-warning py-2 small" role="alert">@Text["Documents.JobsUnavailable", OcrText.Localize(jobsError)]</div>
}

<section class="dash-card project-card mb-4" aria-labelledby="project-title">
    <div class="dash-card-head">
        <h2 id="project-title" class="h5 mb-0">@Text["Project.Heading"]</h2>
        <span id="project-status" class="badge kpi-status @KpiStatusClass(ProjectStatus)">@Text.KpiStatusName(ProjectStatus)</span>
        <a class="dash-card-link" href="reports?report=Progress">@Text["Project.Report"]</a>
    </div>
    <p class="project-figure mb-2">
        <span id="project-pages" class="project-value">@FormatNumber(ProjectPages)</span>
        <span>@Text["Project.OfTotal", FormatNumber(Plan.TotalPages), FormatPercent(ProjectPercent)]</span>
        <span class="project-documents">· <strong id="project-documents">@FormatNumber(ProjectDocuments)</strong> @Text["Project.Documents"]</span>
    </p>
    <div class="project-meter" role="img" aria-label="@ProjectSummary">
        <span class="project-fill @KpiStatusClass(ProjectStatus)" style="width: @CssPercent(ProjectPercent)"></span>
        <span class="project-plan" style="inset-inline-start: @CssPercent(PlannedPercent)"></span>
    </div>
    <ul class="project-facts">
        <li><i class="legend-plan" aria-hidden="true"></i>@Text["Project.PlanToDate", FormatNumber(PlannedPages), FormatPercent(PlannedPercent)]</li>
        <li id="project-gap">@ProjectGap</li>
        <li>@Text["Project.Dates", FormatDate(Plan.Start), FormatDate(Plan.End)]</li>
        <li id="project-pace">@ProjectPace</li>
    </ul>
</section>

<section class="dash-card status-card mb-4" aria-labelledby="status-title">
    <div class="dash-card-head">
        <h2 id="status-title" class="h5 mb-0">@Text["Status.Heading"]</h2>
        <span class="text-muted small">
            <span id="status-total">@Text["Status.Total", FormatNumber(Report.Documents)]</span>
            @if (Report.DocumentsChangePercent is { } change)
            {
                <span> · @Text["Kpi.VsPrevious", FormatSigned(change, "0.0") + "%"]</span>
            }
        </span>
        <a class="dash-card-link" href="documents">@Text["Dashboard.OpenDocuments"]</a>
    </div>
    <StatusBreakdown Counts="StatusCounts" Label="@Text["Status.Heading"]" Href="StatusUrl" />
</section>

<section class="dash-card kpi-section mb-4" aria-labelledby="kpi-title">
    <div class="dash-card-head">
        <h2 id="kpi-title" class="h5 mb-0">@Text["KpiBoard.Heading"]</h2>
        <span id="kpi-summary" class="text-muted small">@KpiSummary</span>
        <a class="dash-card-link" href="admin?tab=Kpi">@Text["KpiBoard.Edit"]</a>
    </div>
    @if (VisibleKpis.Count == 0)
    {
        <p class="text-muted mb-0">@Text["KpiBoard.None"]</p>
    }
    else
    {
        <div class="kpi-board">
            @foreach (var target in VisibleKpis)
            {
                <KpiCard Target="target" Actual="Report.Actual(target.Kind)" Note="@KpiNote(target.Kind)">
                    @if (target.Kind == KpiKind.ReviewBacklog)
                    {
                        <a class="btn btn-sm btn-primary" href="review">@Text["Kpi.OpenReview"]</a>
                    }
                    else if (target.Kind == KpiKind.FailureRate)
                    {
                        <a class="kpi-failed" href="documents?status=Failed">@Text["Kpi.Failed", FormatNumber(Report.Failed)]</a>
                    }
                </KpiCard>
            }
        </div>
    }
</section>

<div class="dash-row mb-4">
    <section class="dash-card dash-chart" aria-labelledby="chart-title">
        <h2 id="chart-title" class="h5">@ChartTitle</h2>
        <div class="bar-chart" role="img" aria-label="@ChartSummary">
            <div class="bar-axis" aria-hidden="true">
                <span>@FormatNumber(ScaleMax)</span>
                <span>@FormatNumber(ScaleMax / 2)</span>
                <span>0</span>
            </div>
            <div class="bar-area">
                <div class="bar-plot">
                    <span class="bar-gridline" style="bottom: 50%" aria-hidden="true"></span>
                    <span class="bar-gridline" style="bottom: 100%" aria-hidden="true"></span>
                    <div class="bars">
                        @for (var i = 0; i < Report.Bars.Count; i++)
                        {
                            var bar = Report.Bars[i];
                            @* The last bar is the hour or day still in progress, so it is drawn apart. *@
                            <div class="bar-slot" title="@Text["Chart.BarTip", BarLabel(bar, full: true), FormatNumber(bar.Pages)]">
                                <span class="bar @(i == Report.Bars.Count - 1 ? "bar-current" : null)" style="height: @CssPercent(bar.Pages * 100d / ScaleMax)"></span>
                            </div>
                        }
                    </div>
                    <span class="bar-target" style="bottom: @CssPercent(BarTarget * 100d / ScaleMax)" aria-hidden="true">
                        <span>@Text["Chart.Target", FormatNumber(BarTarget)]</span>
                    </span>
                </div>
                <div class="bar-labels" aria-hidden="true">
                    @for (var i = 0; i < Report.Bars.Count; i++)
                    {
                        <span>@(ShowLabel(i) ? BarLabel(Report.Bars[i], full: false) : null)</span>
                    }
                </div>
            </div>
        </div>
        <div class="chart-legend" aria-hidden="true">
            <span><i class="legend-bar"></i>@Text["Chart.Pages"]</span>
            <span><i class="legend-bar legend-current"></i>@Text["Chart.Current"]</span>
            <span><i class="legend-target"></i>@Text["Chart.TargetLegend"]</span>
        </div>
        <details class="mt-3">
            <summary class="small">@Text["Chart.ShowTable"]</summary>
            <div class="table-responsive position-relative mt-2">
                <table class="table table-sm">
                    <caption class="visually-hidden">@ChartTitle</caption>
                    <thead>
                        <tr>
                            <th scope="col">@Text["Chart.Period"]</th>
                            <th scope="col" class="text-end">@Text["Chart.Pages"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bar in Report.Bars)
                        {
                            <tr>
                                <td>@BarLabel(bar, full: true)</td>
                                <td class="text-end">@FormatNumber(bar.Pages)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </details>
    </section>

    <section class="dash-card dash-dept" aria-labelledby="dept-title">
        <h2 id="dept-title" class="h5">@Text["Dept.Heading"]</h2>
        <div class="table-responsive position-relative">
            <table class="table align-middle mb-0">
                <caption class="visually-hidden">@Text["Dept.Heading"]</caption>
                <thead>
                    <tr>
                        <th scope="col">@Text["Dept.Department"]</th>
                        <th scope="col" class="text-end">@Text["Dept.Documents"]</th>
                        <th scope="col" class="text-end">@Text["Dept.Pages"]</th>
                        <th scope="col" class="text-end">@Text["Dept.Confidence"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Report.Departments)
                    {
                        <tr>
                            <td>
                                @if (row.Department is { } department)
                                {
                                    <a href="@($"documents?department={department}")">@DepartmentName(department)</a>
                                }
                                else
                                {
                                    @DepartmentName(null)
                                }
                            </td>
                            <td class="text-end">@FormatNumber(row.Documents)</td>
                            <td class="text-end">@FormatNumber(row.Pages)</td>
                            <td class="text-end">@(row.Confidence is { } confidence ? FormatPercent(confidence) : Missing)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
