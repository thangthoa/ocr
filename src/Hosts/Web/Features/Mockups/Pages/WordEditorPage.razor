@page "/documents/{Id}/word"
@rendermode InteractiveServer

<PageTitle>@Text["Word.Title"] · @(_session?.Document.FileName ?? Id)</PageTitle>

<div class="word-page">
    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
        <a href="@OcrEndpoints.JobUrl(Id)"><span aria-hidden="true">@BackArrow</span> @Text["Word.Back"]</a>
    </div>
    <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
        <h1 class="h4 mb-0 me-auto text-break" dir="auto">@Text["Word.Title"] · @(_session?.Document.FileName ?? Id)</h1>
        @if (_session is not null)
        {
            <span class="small text-muted">@Text["Word.FileVersion", _session.Version.Number]</span>
        }
    </div>
    <p class="small text-muted mb-2">@Text["Word.Help"]</p>

    @if (_error is not null)
    {
        <div class="alert alert-danger d-flex flex-wrap align-items-center gap-2" role="alert">
            <span class="me-auto">@_error</span>
            <button type="button" id="word-retry" class="btn btn-sm btn-outline-secondary" disabled="@_opening" @onclick="OpenAsync">@Text["Word.Retry"]</button>
        </div>
    }
    else if (_session is null)
    {
        <p class="text-muted" role="status">@Text["Word.Opening"]</p>
    }
    else if (_stalledHost is not null)
    {
        @* The host is isolated so it keeps its left-to-right order inside Arabic text. *@
        <div id="word-stalled" class="alert alert-warning d-flex flex-wrap align-items-center gap-2" role="alert">
            <span class="me-auto">@(Text["Word.Stalled", $"\u2068{_stalledHost}\u2069"])</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_opening" @onclick="OpenAsync">@Text["Word.Retry"]</button>
        </div>
    }

    @* Filled by wwwroot/js/word-editor.js; Blazor never renders children here. *@
    <div class="word-frame @(_session is null || _error is not null ? "d-none" : null)" @ref="_container"></div>
</div>
