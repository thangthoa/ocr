@page "/ocr/jobs/{JobId}"
@rendermode InteractiveServer
@using System.Globalization
@using Modules.Ocr.Application.Contracts
@using Modules.Ocr.Domain.Jobs
@using OppOcr.Web.Features.Ocr.Components

<PageTitle>@(_job?.FileName ?? Text["JobTitle"])</PageTitle>

<p><a href="ocr/jobs"><span aria-hidden="true">@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "→" : "←")</span> @Text["BackToJobs"]</a></p>

@if (_deleted)
{
    <div class="alert alert-info" role="status">@Text["JobDeleted"] <a href="ocr/jobs">@Text["BackToJobs"]</a></div>
}
else if (_notFound)
{
    <div class="alert alert-warning" role="alert">@Text["JobNotFound"]</div>
}
else if (_job is null && _error is not null)
{
    <div class="alert alert-danger" role="alert">
        @_error
        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="LoadAsync">@Text["Retry"]</button>
    </div>
}
else if (_job is null)
{
    <p class="text-muted" role="status">@Text["Loading"]</p>
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0 me-auto text-break" dir="auto">@_job.FileName</h1>
        <OcrStatusBadge Status="_job.Status" />
        <ConfirmButton Label="@Text["Delete"]" ConfirmLabel="@Text["Delete"]" CancelLabel="@Text["Cancel"]"
                       BusyLabel="@Text["Deleting"]" ConfirmGroupLabel="@Text["ConfirmDelete"]"
                       AriaLabel="@Text["DeleteJob", _job.FileName]" Busy="_deleting" OnConfirm="DeleteAsync" />
    </div>

    @if (!_job.CanCancel)
    {
        <p class="small text-muted">@Text["DeleteNote"]</p>
    }

    @if (_deleteError is not null)
    {
        <div class="alert alert-danger" role="alert">@_deleteError</div>
    }

    @if (_error is not null)
    {
        @* Keep showing the last known state; refreshing will retry. *@
        <div class="alert alert-warning py-2 small" role="status">@_error</div>
    }

    <dl class="row small mb-3">
        <dt class="col-sm-3">@Text["Column.Type"]</dt>
        <dd class="col-sm-9">@Text.DocumentType(_job.DocumentType)</dd>
        <dt class="col-sm-3">@Text["Detail.JobId"]</dt>
        <dd class="col-sm-9"><code dir="ltr">@_job.Id.Value</code></dd>
        @if (_job.CreatedAtUtc is not null)
        {
            <dt class="col-sm-3">@Text["Column.Created"]</dt>
            <dd class="col-sm-9">@_job.CreatedAtUtc.Value.ToLocalTime().ToString("g")</dd>
        }
        @if (_job.FinishedAtUtc is not null)
        {
            <dt class="col-sm-3">@Text["Detail.Completed"]</dt>
            <dd class="col-sm-9">@_job.FinishedAtUtc.Value.ToLocalTime().ToString("g")</dd>
        }
        @if (!_job.IsFinished)
        {
            <dt class="col-sm-3">@Text["Column.Progress"]</dt>
            <dd class="col-sm-9" aria-live="polite">
                <OcrProgress Status="_job.Status" PagesTotal="_job.PagesTotal" PagesDone="_job.PagesDone"
                             CurrentStep="@_job.CurrentStep" QueuePosition="_job.QueuePosition" />
            </dd>
        }
    </dl>

    @if (_job.Status == OcrJobStatus.Failed)
    {
        <div class="alert alert-danger" role="alert" title="@_job.ErrorMessage">@Text.JobError(_job.ErrorCode)</div>
    }

    @if (_job.Status == OcrJobStatus.Done)
    {
        <div class="mb-3 d-flex flex-wrap align-items-center gap-2">
            <span class="small">@Text["Download"]:</span>
            @foreach (var format in Enum.GetValues<OcrResultFormat>())
            {
                <a class="btn btn-sm btn-outline-primary" href="@OcrEndpoints.DownloadUrl(_job.Id.Value, format)" download>@format.ToString().ToUpperInvariant()</a>
            }
        </div>
    }

    @if (_job.Pages.Count == 0)
    {
        @if (!_job.IsFinished)
        {
            <p class="text-muted">@Text["PagesPending"]</p>
        }
    }
    else
    {
        @foreach (var ocrPage in _job.Pages)
        {
            <section class="card mb-3" aria-labelledby="@($"page-{ocrPage.PageNumber}")" @key="ocrPage.PageNumber">
                <div class="card-header d-flex flex-wrap gap-2 align-items-center">
                    <h2 id="@($"page-{ocrPage.PageNumber}")" class="h6 mb-0 me-auto">@Text["PageHeading", ocrPage.PageNumber, _job.PagesTotal]</h2>
                    <span class="small text-muted">@Text.DocumentType(ocrPage.Type) · @Text["Seconds", ocrPage.Seconds.ToString("0")] @(ocrPage.Cached ? $"· {Text["Cached"]}" : null)</span>
                </div>
                <div class="card-body">
                    @if (ocrPage.Warnings.Count > 0)
                    {
                        <ul class="list-unstyled small text-warning-emphasis mb-2">
                            @foreach (var warning in ocrPage.Warnings)
                            {
                                <li><span aria-hidden="true">⚠</span> <span title="@warning">@Text.Warning(warning)</span></li>
                            }
                        </ul>
                    }
                    <div class="row g-3">
                        <div class="col-md-5">
                            <img src="@OcrEndpoints.PageImageUrl(_job.Id.Value, ocrPage.PageNumber)" class="img-fluid border rounded page-image"
                                 alt="@Text["PageImageAlt", ocrPage.PageNumber]" loading="lazy" />
                        </div>
                        <div class="col-md-7">
                            <div class="ocr-text" dir="rtl" lang="ar">@ocrPage.Text</div>
                        </div>
                    </div>
                </div>
            </section>
        }
    }
}
