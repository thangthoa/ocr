@page "/ocr/jobs"
@rendermode InteractiveServer
@using Modules.Ocr.Application.Features.ListOcrJobs
@using Modules.Ocr.Domain.Jobs
@using OppOcr.Web.Features.Ocr.Components

<PageTitle>@Text["JobsTitle"]</PageTitle>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0 me-auto">@Text["JobsTitle"]</h1>
    <div class="input-group input-group-sm job-search" role="search">
        <span class="input-group-text" aria-hidden="true">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.868-3.834zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" /></svg>
        </span>
        <input id="job-search" type="search" class="form-control" placeholder="@Text["SearchPlaceholder"]" aria-label="@Text["SearchPlaceholder"]"
               @bind="_search" @bind:event="oninput" @bind:after="SearchChangedAsync" autocomplete="off" spellcheck="false" />
    </div>
    <label class="visually-hidden" for="status-filter">@Text["FilterByStatus"]</label>
    <select id="status-filter" class="form-select form-select-sm w-auto" @onchange="FilterChangedAsync">
        <option value="" selected="@(_status is null)">@Text["AllStatuses"]</option>
        @foreach (var status in Enum.GetValues<OcrJobStatus>())
        {
            <option value="@status" selected="@(_status == status)">@Text.Status(status)</option>
        }
    </select>
    <a class="btn btn-sm btn-primary" href="ocr">@Text["NewUpload"]</a>
</div>

@if (_list is { FromService: false })
{
    <div class="alert alert-info py-2 small" role="note">@Text["ListFromMemoryNotice"]</div>
}

@if (_list is { SearchLimitReached: true })
{
    <div class="alert alert-secondary py-2 small" role="note">@Text["SearchLimited", ListOcrJobsQuery.MaxJobsScannedBySearch]</div>
}

@if (_error is not null)
{
    <div class="alert alert-danger" role="alert">
        @_error
        <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="() => LoadAsync(_page)">@Text["Retry"]</button>
    </div>
}
else if (_list is null)
{
    <p class="text-muted" role="status">@Text["Loading"]</p>
}
else if (_list.Jobs.TotalCount == 0 && !string.IsNullOrWhiteSpace(_search))
{
    <p class="text-muted" role="status">@Text["NoMatches", _search.Trim()]</p>
}
else if (_list.Jobs.TotalCount == 0)
{
    <p class="text-muted">@Text["NoJobs"] <a href="ocr">@Text["NewUpload"]</a></p>
}
else
{
    var jobs = _list.Jobs;
    @* position-relative keeps the visually-hidden caption inside the scroll box; otherwise it widens the page. *@
    <div class="table-responsive position-relative">
        <table class="table align-middle">
            <caption class="visually-hidden">@Text["JobsTitle"]</caption>
            <thead>
                <tr>
                    <th scope="col" style="min-width: 12rem">@Text["Column.File"]</th>
                    <th scope="col">@Text["Column.Type"]</th>
                    <th scope="col">@Text["Column.Status"]</th>
                    <th scope="col">@Text["Column.Progress"]</th>
                    <th scope="col">@Text["Column.Created"]</th>
                    <th scope="col"><span class="visually-hidden">@Text["Column.Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var job in jobs.Items)
                {
                    <tr @key="job.Id">
                        <td class="text-break"><a href="@OcrEndpoints.JobUrl(job.Id.Value)" dir="auto">@job.FileName</a></td>
                        <td class="text-nowrap">@Text.DocumentType(job.DocumentType)</td>
                        <td><OcrStatusBadge Status="job.Status" /></td>
                        <td style="min-width: 12rem">
                            @if (job.Status == OcrJobStatus.Failed)
                            {
                                <span class="text-danger small">@Text.JobError(job.ErrorCode)</span>
                            }
                            else
                            {
                                <OcrProgress Status="job.Status" PagesTotal="job.PagesTotal" PagesDone="job.PagesDone"
                                             CurrentStep="@job.CurrentStep" QueuePosition="job.QueuePosition" />
                            }
                        </td>
                        <td class="small text-nowrap">@job.CreatedAtUtc?.ToLocalTime().ToString("g")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" href="@OcrEndpoints.JobUrl(job.Id.Value)">@Text["View"]</a>
                            <ConfirmButton Label="@Text["Delete"]" ConfirmLabel="@Text["Delete"]" CancelLabel="@Text["Cancel"]"
                                           BusyLabel="@Text["Deleting"]" ConfirmGroupLabel="@Text["ConfirmDelete"]"
                                           AriaLabel="@Text["DeleteJob", job.FileName]" Busy="@(_deletingId == job.Id.Value)"
                                           OnConfirm="() => DeleteAsync(job.Id.Value)" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_deleteError is not null)
    {
        <div class="alert alert-danger" role="alert">@_deleteError</div>
    }

    @if (jobs.TotalPages > 1)
    {
        <nav class="d-flex align-items-center gap-2" aria-label="@Text["Pagination"]">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!jobs.HasPreviousPage)" @onclick="() => LoadAsync(_page - 1)">@Text["Previous"]</button>
            <span class="small">@Text["PageOf", jobs.Page, jobs.TotalPages]</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!jobs.HasNextPage)" @onclick="() => LoadAsync(_page + 1)">@Text["Next"]</button>
        </nav>
    }
}
