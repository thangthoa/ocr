@page "/scan"
@page "/capture"
@page "/ocr"
@rendermode InteractiveServer
@using Modules.Ocr.Domain.Jobs
@using OppOcr.Web.Features.Ocr.Components

<PageTitle>@Text["UploadTitle"]</PageTitle>

<div class="page-head mb-4">
    <div class="min-w-0">
        <h1 class="h3 mb-1">@Text["UploadTitle"]</h1>
        <p class="text-muted mb-0">@Text["UploadIntro"]</p>
    </div>
    <a class="btn btn-outline-primary" href="documents">@Text["GoToJobs"]</a>
</div>

<section class="scan-card">

<fieldset class="capture-options mb-3" disabled="@_uploading">
    <legend class="visually-hidden">@Text["Options.Legend"]</legend>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <label for="doc-type" class="form-label">@Text["DocumentTypeLegend"] <span class="text-danger" aria-hidden="true">*</span></label>
            <select id="doc-type" class="form-select" aria-required="true" @bind="_documentType">
                @foreach (var type in Enum.GetValues<OcrDocumentType>())
                {
                    <option value="@type">@Text.DocumentType(type)</option>
                }
            </select>
        </div>

        <div class="col-12 col-md-4">
            <span id="mode-label" class="form-label d-block">@Text["Mode.Label"]</span>
            <div class="btn-group" role="radiogroup" aria-labelledby="mode-label" aria-describedby="mode-hint">
                @foreach (var mode in Enum.GetValues<CaptureMode>())
                {
                    var id = $"mode-{mode}";
                    <input type="radio" class="btn-check" name="capture-mode" id="@id" autocomplete="off"
                           checked="@(_mode == mode)" @onchange="() => SetMode(mode)" />
                    <label class="btn btn-outline-primary" for="@id">@Text[$"Mode.{mode}"]</label>
                }
            </div>
            <div id="mode-hint" class="form-text">
                @(_mode == CaptureMode.One ? Text["Mode.One.Hint"] : Text["Mode.Multi.Hint", OcrRules.MaxPagesPerDocument])
            </div>
        </div>

        <div class="col-12 col-md-4">
            <label for="file-name" class="form-label">@Text["FileName.Label"] <span class="text-danger" aria-hidden="true">*</span></label>
            <input id="file-name" class="form-control @(ShowNameError ? "is-invalid" : null)" dir="auto" autocomplete="off"
                   maxlength="@OcrRules.MaxFileNameLength" aria-required="true" aria-invalid="@(ShowNameError ? "true" : null)"
                   aria-describedby="file-name-help" @bind="_fileName" @bind:event="oninput" />
            @if (ShowNameError)
            {
                <div id="file-name-help" class="invalid-feedback">@Text["ocr.file_name_required"]</div>
            }
            else
            {
                <div id="file-name-help" class="form-text text-truncate">
                    @if (SavedName is { } saved)
                    {
                        <text>@Text["FileName.SavedAs"] <bdi>@saved</bdi></text>
                    }
                    else
                    {
                        <text>@Text["FileName.Hint"]</text>
                    }
                </div>
            }
        </div>
    </div>
</fieldset>

<FileDropZone Id="ocr-files" Accept="@Accept" Multiple="@(_mode == CaptureMode.Multi)" OnFilesSelected="SelectFiles"
              Disabled="@_uploading"
              Prompt="@(_mode == CaptureMode.One ? Text["DropZonePrompt"] : Text["DropZonePrompt.Multi"])"
              Hint="@DropZoneHint" />

@if (_mode == CaptureMode.Multi)
{
    <div class="folder-upload mt-3">
        <span id="ocr-folder-hint" class="small text-muted">@Text["FolderPrompt"]</span>
        @* webkitdirectory lets the browser pick a whole folder (all current browsers support it). *@
        <InputFile id="ocr-folder" class="folder-input" OnChange="SelectFolder" multiple webkitdirectory="true"
                   disabled="@_uploading" aria-describedby="ocr-folder-hint" />
        <label for="ocr-folder" class="btn btn-sm btn-outline-primary @(_uploading ? "disabled" : null)">@Text["ChooseFolder"]</label>
    </div>
}

@if (_error is not null)
{
    <div id="capture-error" class="alert alert-danger mt-3" role="alert">@_error</div>
}

@if (_note is not null)
{
    <div class="alert alert-info mt-3 py-2" role="status">@_note</div>
}

@if (_files.Count > 0)
{
    <section class="selected-files mt-3" aria-labelledby="selected-title">
        <h2 id="selected-title" class="h6 mb-2">
            @(_mode == CaptureMode.Multi ? Text["Selected.Pages", _files.Count] : Text["Selected.File"])
        </h2>
        <ol class="list-group list-group-numbered">
            @for (var i = 0; i < _files.Count; i++)
            {
                var index = i;
                var file = _files[i];
                <li @key="file" class="list-group-item d-flex align-items-center gap-2">
                    <span class="text-truncate me-auto"><bdi>@file.Name</bdi> <span class="text-muted small">(@FileSizeFormatter.Format(file.Size))</span></span>
                    @if (_mode == CaptureMode.Multi)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary move-up" disabled="@(_uploading || index == 0)"
                                title="@Text["Selected.MoveUp", file.Name]" aria-label="@Text["Selected.MoveUp", file.Name]"
                                @onclick="() => Move(index, -1)"><span aria-hidden="true">↑</span></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary move-down" disabled="@(_uploading || index == _files.Count - 1)"
                                title="@Text["Selected.MoveDown", file.Name]" aria-label="@Text["Selected.MoveDown", file.Name]"
                                @onclick="() => Move(index, 1)"><span aria-hidden="true">↓</span></button>
                    }
                    <button type="button" class="btn btn-sm btn-outline-danger remove" disabled="@_uploading"
                            title="@Text["Selected.Remove", file.Name]" aria-label="@Text["Selected.Remove", file.Name]"
                            @onclick="() => Remove(index)"><span aria-hidden="true">×</span></button>
                </li>
            }
        </ol>
        @if (_mode == CaptureMode.Multi)
        {
            <p class="form-text mb-0">@Text["Selected.ReplaceHint"]</p>
        }
    </section>
}

<div class="d-flex flex-wrap gap-2 mt-3">
    <button type="button" id="upload-button" class="btn btn-primary" disabled="@(_uploading || _files.Count == 0)" @onclick="UploadAsync">
        @(_uploading ? Text["Uploading"] : Text["Upload"])
    </button>
    @if (_files.Count > 0 && !_uploading)
    {
        <button type="button" class="btn btn-outline-secondary" @onclick="ClearSelection">@Text["ClearSelection"]</button>
    }
</div>
</section>
