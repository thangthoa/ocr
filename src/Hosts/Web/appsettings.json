{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Ocr": {
    "Api": {
      "BaseUrl": "http://n2.ckey.vn:1436",
      "RequestTimeoutSeconds": 300
    },
    "Worker": {
      "Enabled": true,
      "PollIntervalSeconds": 3
    }
  }
}
